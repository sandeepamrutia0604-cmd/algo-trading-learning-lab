APP_NAME=Algo Trading Learning Lab
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/algo_trading.db

# Market data adapter. "dummy" (default) uses this app's own simulated prices.
# "angel_one" logs into a real Angel One (SmartAPI) account for real NSE candles/LTP.
# Fill these in only in your own local .env -- this file is gitignored, never commit real
# values. ANGEL_ONE_PIN is your account login PIN; ANGEL_ONE_TOTP_SECRET is the secret key
# shown when you enable TOTP 2FA on your account (not a 6-digit code -- the seed behind it).
MARKET_DATA_PROVIDER=dummy
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PIN=
ANGEL_ONE_TOTP_SECRET=
